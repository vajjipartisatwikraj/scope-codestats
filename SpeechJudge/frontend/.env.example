# Test console settings. Copy to frontend/.env (git-ignored) and edit. Read by frontend/server.py.
# Values here override speech-judge/.env; real environment variables override both.

# Where /api/v1/* is forwarded.
#   SSH tunnel to the server:  ssh -i <key.pem> -N -L 8001:127.0.0.1:8000 ubuntu@<SERVER_IP>  ->  http://127.0.0.1:8001
#   Local backend:             leave empty (defaults to http://SJ_HOST:SJ_PORT from speech-judge/.env)
BACKEND_URL=http://127.0.0.1:8001

# The server's SJ_SERVICE_CREDENTIALS value (the proxy adds it as the Bearer token; it never reaches the browser).
# Empty = use the first credential from speech-judge/.env, which only works for a local backend.
FRONTEND_API_KEY=

# Port of this UI (it binds to 127.0.0.1 only).
FRONTEND_PORT=8080
