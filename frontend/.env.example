# CodeStats frontend environment. Copy this file to .env and fill it in.
#
# Every VITE_* value is copied into the built JavaScript when you run "npm run build", so it is public:
# never put a secret here. After changing a value, build again.

# ── Server ──────────────────────────────────────────────────────────────────────
# The address of the API, including /api
VITE_API_URL=http://localhost:5000/api

# ── Sign-in ─────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
# Any random string. It encrypts code copied inside the code editor.
VITE_ENCODING_ENCRYPT_KEY=

# ── Brand (see src/brand/index.js) ──────────────────────────────────────────────
# Which pictures to use: the folder names in src/brand/platforms/ and src/brand/institutions/.
# An unknown folder name stops the build and lists the folders that exist.
VITE_PLATFORM=codestats
VITE_INSTITUTION=mlrit
# The names used in all the text of the app. Empty means the name in the folder's brand.json.
VITE_PLATFORM_NAME=CodeStats
VITE_INSTITUTION_NAME=MLRIT

# ── Optional ────────────────────────────────────────────────────────────────────
# Your own logo.dev token for company logos
# VITE_LOGO_DEV_TOKEN=
